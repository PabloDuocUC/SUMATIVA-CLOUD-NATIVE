{
  "info": {
    "name": "Tickets Service - CDY2204 Semana 3",
    "description": "Sistema de Gestion de Reservas de Eventos con Tickets. Cambiar la variable baseUrl por http://IP_PUBLICA_EC2:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Generar ticket (EFS + subida automatica a S3)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tickets",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tickets"
          ]
        },
        "description": "Genera el PDF en EFS y lo sube a S3 en evento123/usuarioX/ticketNNN.pdf. Guarda el id en la variable ticketId.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventoId\": \"evento123\",\n  \"usuarioId\": \"usuarioX\",\n  \"nombreEvento\": \"Festival Cloud Native 2026\",\n  \"nombreAsistente\": \"Ana Rojas\",\n  \"fechaEvento\": \"2026-12-05T21:00:00\",\n  \"asiento\": \"A-10\",\n  \"precio\": 25000,\n  \"estado\": \"VENDIDO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Subido a S3', () => pm.expect(pm.response.json().subidoAS3).to.eql(true));",
              "pm.collectionVariables.set('ticketId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
